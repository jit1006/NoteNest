{
  "name": "notenest",
  "private": true,
  "version": "2.0.0",
  "description": "NoteNest V2 - collaborative academic knowledge library (React + Supabase)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:data": "node scripts/check-catalog.mjs",
    "test:logic": "node scripts/test-logic.ts",
    "test:e2e": "node e2e/smoke.mjs",
    "check": "npm run check:data && npm run test:logic && npm run build",
    "pdfs": "python3 tools/generate_pdfs.py && python3 tools/verify_pdfs.py",
    "test:db": "node --test --test-concurrency=2 \"tests/db/*.test.mjs\"",
    "seed:demo": "node scripts/seed-demo.mjs",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@supabase/supabase-js": "^2.46.1",
    "@tanstack/react-query": "^5.59.20",
    "@tiptap/extension-code-block-lowlight": "^2.10.3",
    "@tiptap/extension-color": "^2.10.3",
    "@tiptap/extension-highlight": "^2.10.3",
    "@tiptap/extension-link": "^2.10.3",
    "@tiptap/extension-placeholder": "^2.10.3",
    "@tiptap/extension-table": "^2.10.3",
    "@tiptap/extension-table-cell": "^2.10.3",
    "@tiptap/extension-table-header": "^2.10.3",
    "@tiptap/extension-table-row": "^2.10.3",
    "@tiptap/extension-task-item": "^2.10.3",
    "@tiptap/extension-task-list": "^2.10.3",
    "@tiptap/extension-text-style": "^2.10.3",
    "@tiptap/extension-underline": "^2.10.3",
    "@tiptap/pm": "^2.10.3",
    "@tiptap/react": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "dompurify": "^3.2.1",
    "highlight.js": "^11.10.0",
    "jszip": "^3.10.1",
    "lowlight": "^3.1.0",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-markdown": "^9.0.1",
    "react-pdf": "^9.1.1",
    "react-router-dom": "^6.28.0",
    "rehype-highlight": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.49.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}
