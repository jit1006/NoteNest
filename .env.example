# Copy to .env.local for development. These are PUBLIC build-time values (they end up in the JS bundle).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<anon / publishable key from `supabase status`>
VITE_ENABLE_GOOGLE_AUTH=false

# NEVER put the service-role key in a VITE_* variable or in the repository.
# It is only used by scripts/seed-demo.mjs and tests/db/*, passed via the shell environment:
#   SUPABASE_URL=… SUPABASE_SERVICE_ROLE_KEY=… node scripts/seed-demo.mjs
